{
  "name": "dsh-attention",
  "version": "0.2.1",
  "description": "DeepSeek Harness 插件：审批/提问时弹出可操作的 Windows Toast，并在浏览器标签休眠后唤醒重连，避免提权卡片卡住",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "toast",
    "notification",
    "approval",
    "windows"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Gaq152/dsh-attention#readme",
  "bugs": {
    "url": "https://github.com/Gaq152/dsh-attention/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gaq152/dsh-attention.git"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "assets",
    "src",
    "client",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/smoke.mjs",
    "check": "node --check src/index.js && node --check src/toast.js && node --check src/util.js && node --check src/protocol.js && node --check src/persist.js && node --check src/ui-page.js && node --check src/inbox.js && node --check client/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  }
}
